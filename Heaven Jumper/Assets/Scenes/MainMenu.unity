  m_text: "\u0426\u044F \u0433\u0440\u0430 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
    \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u0443
    \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0447\u043E\u0457 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u043C [\u0412\u0430\u0448\u0435
    \u0456\u043C\u2019\u044F].\n\n\u041C\u0435\u0442\u0430 \u0440\u043E\u0431\u043E\u0442\u0438
    \u2014 \u0440\u043E\u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043F\u043E\u0432\u043D\u043E\u0446\u0456\u043D\u043D\u0443
    2D-\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440 \u0433\u0440\u0443
    \u0437 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F\u043C
    \u0441\u0443\u0447\u0430\u0441\u043D\u0438\u0445 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432
    \u0442\u0430 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0456\u0454\u044E
    \u043D\u0430\u0431\u0443\u0442\u0438\u0445 \u043D\u0430\u0432\u0438\u0447\u043E\u043A
    \u0443 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043D\u043D\u0456
    \u0442\u0430 \u0433\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D\u0456.\n\n\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u0456
    \u0433\u0440\u0438\n\n\u0416\u0430\u043D\u0440: \u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440
    \u0437 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0430\u0440\u043A\u0430\u0434\u0438.\n\n\u041C\u0435\u0445\u0430\u043D\u0456\u043A\u0438:
    \u0421\u0442\u0440\u0438\u0431\u043A\u0438 \u043D\u0430 \u0445\u043C\u0430\u0440\u0430\u0445,
    \u0437\u0431\u0456\u0440 \u043C\u043E\u043D\u0435\u0442, \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0456
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0456.\n\n\u0420\u0435\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F:\n\u0420\u0443\u0445
    \u0433\u0440\u0430\u0432\u0446\u044F \u0442\u0430 \u0444\u0456\u0437\u0438\u043A\u0430
    \u043E\u0431\u2019\u0454\u043A\u0442\u0456\u0432.\n\u0421\u0438\u0441\u0442\u0435\u043C\u0430
    \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0443
    (\u043C\u043E\u043D\u0435\u0442\u0438, \u043A\u0443\u043F\u0456\u0432\u043B\u044F
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0456\u0432).\n\u0414\u0438\u043D\u0430\u043C\u0456\u0447\u043D\u0438\u0439
    \u0441\u043F\u0430\u0432\u043D \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C
    \u0442\u0430 \u043F\u0435\u0440\u0435\u0448\u043A\u043E\u0434.\n\n\n\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0456
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457\n\n\u0420\u0443\u0445\u043E\u043C\u0438\u0439
    \u043A\u043E\u0434: C# \u0443 \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0456
    Unity.\n\n\u0413\u0440\u0430\u0444\u0456\u043A\u0430: Pixel Art / \u0432\u0435\u043A\u0442\u043E\u0440\u043D\u0430
    \u0433\u0440\u0430\u0444\u0456\u043A\u0430 (\u0432\u043A\u0430\u0437\u0430\u0442\u0438
    \u0432\u0430\u0448 \u0441\u0442\u0438\u043B\u044C).\n\n\u0411\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438:
    UnityEngine, TextMeshPro, DOTween \u0434\u043B\u044F \u0430\u043D\u0456\u043C\u0430\u0446\u0456\u0439.\n\n\u041E\u043F\u0442\u0438\u043C\u0456\u0437\u0430\u0446\u0456\u044F:
    Object Pooling \u0434\u043B\u044F \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u0441\u043F\u0430\u0432\u043D\u0443 \u043E\u0431\u2019\u0454\u043A\u0442\u0456\u0432.\n\n\n\u0410\u0432\u0442\u043E\u0440\u0441\u044C\u043A\u0438\u0439
    \u0432\u043D\u0435\u0441\u043E\u043A\n\n\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043D\u043D\u044F
    \u0432\u0441\u0456\u0445 \u043C\u0435\u0445\u0430\u043D\u0456\u043A \u0437 \u043D\u0443\u043B\u044F.\n\u0414\u0438\u0437\u0430\u0439\u043D
    \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u0442\u0430 \u0440\u0456\u0432\u043D\u0456\u0432.\n\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u0431\u0430\u043B\u0430\u043D\u0441\u0443 \u0433\u0440\u0438 (\u0441\u0438\u043B\u0430
    \u0441\u0442\u0440\u0438\u0431\u043A\u0456\u0432, \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C).\n\n\n\u041F\u043E\u0434\u044F\u043A\u0438\n\n\u041A\u0435\u0440\u0456\u0432\u043D\u0438\u043A\u0443
    \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438 \u0437\u0430 \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0456\u0457
    \u0442\u0430 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0443.\n\u041D\u0430\u0432\u0447\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u0437\u0430\u043A\u043B\u0430\u0434\u0443 \u041D\u0430\u0437\u0432\u0430 \u0432\u0430\u0448\u043E\u0433\u043E
    \u0437\u0430\u043A\u043B\u0430\u0434\u0443 \u0437\u0430 \u043D\u0430\u0434\u0430\u043D\u0456
    \u0440\u0435\u0441\u0443\u0440\u0441\u0438.\n\u041A\u043E\u043D\u0442\u0430\u043A\u0442\u0438
    \u0434\u043B\u044F \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u0433\u043E
    \u0437\u0432\u2019\u044F\u0437\u043A\u0443:\n\nEmail: [\u0432\u0430\u0448\u0430
    \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0430 \u0430\u0434\u0440\u0435\u0441\u0430]\nLinkedIn/GitHub:
    [\u043F\u043E\u0441\u0438\u043B\u0430\u043D\u043D\u044F, \u044F\u043A\u0449\u043E
    \u0454]\n\n\u0413\u0440\u0430 \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0430
    \u0434\u043B\u044F \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0456\u0457
    \u043D\u0430\u0432\u0438\u0447\u043E\u043A \u0442\u0430 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F
    \u0432\u0438\u043C\u043E\u0433 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438.
    \u0414\u044F\u043A\u0443\u044E \u0437\u0430 \u0433\u0440\u0443!"
  m_isRightToLeft: 0
